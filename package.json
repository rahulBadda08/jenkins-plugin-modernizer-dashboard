{
  "name": "jenkins-plugin-modernizer-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "homepage": "https://rahulBadda08.github.io/jenkins-plugin-modernizer-dashboard/",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "data:refresh": "node scripts/fetchData.mjs",
    "data:verify": "node scripts/verifyData.mjs",
    "budget:check": "node scripts/checkBundleSize.mjs",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run data:verify && npm run build && npm run budget:check",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.6.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.64.1",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.5.0",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.4.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.0",
    "vitest": "^5.0.5"
  }
}
